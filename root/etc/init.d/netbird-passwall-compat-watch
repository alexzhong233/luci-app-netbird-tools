#!/bin/sh /etc/rc.common

# 事件驱动的 NetBird / PassWall 兼容规则守护，也是固件里唯一的兼容守护。
# 实际的改规则实现放在 /usr/bin/netbird-passwall-compat.sh，本服务只负责
# 用 nft monitor 监听事件并调度它（--once），那个脚本不再单独注册服务。
#
# 默认不运行。只有 /etc/config/netbird-passwall-compat 里显式写了
#
#   option mode 'watch'
#
# 才会启动，兜底间隔取 option watchdog（默认 60 秒，0 关闭兜底）。
# 临时覆盖仍然可用：WATCHDOG=120 /etc/init.d/netbird-passwall-compat-watch restart

START=99
STOP=10
USE_PROCD=1

TAG="netbird-passwall-compat-watch"
CFG="netbird-passwall-compat.settings"

start_service() {
	local mode watchdog

	mode=$(uci -q get "$CFG.mode" 2>/dev/null)
	if [ "$mode" != "watch" ]; then
		logger -t "$TAG" "mode='${mode:-unset}'，未启用事件守护（需要 ${CFG}.mode=watch）"
		return 0
	fi

	watchdog="${WATCHDOG:-$(uci -q get "$CFG.watchdog" 2>/dev/null)}"
	[ -n "$watchdog" ] || watchdog=60

	procd_open_instance
	procd_set_param command /usr/bin/netbird-passwall-compat-watch.sh
	procd_set_param env WATCHDOG="$watchdog"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
